  pkgdesc="Firmware files for Linux - Firmware for Intel GPUs, WiFi, Bluetooth and NICs"
  depends=(linux-firmware-whence)
  _pick_fw i915 xe intel 'iwlwifi-*' 'ibt-*' ice e100 ipu3-fw.bin ti-connectivity ene-ub6250
}

