# Maintainer: Ovi Chis <ovi@ovios.org>
# Based on the Arch Linux package layout

pkgbase=linux-firmware
pkgname=(
  linux-firmware-amdgpu
  linux-firmware-atheros
  linux-firmware-broadcom
  linux-firmware-cirrus
  linux-firmware-intel
  linux-firmware-liquidio
  linux-firmware-marvell
  linux-firmware-mediatek
  linux-firmware-mellanox
  linux-firmware-nfp
  linux-firmware-nvidia
  linux-firmware-qcom
  linux-firmware-qlogic
  linux-firmware-radeon
  linux-firmware-realtek
  linux-firmware-whence
  linux-firmware-other
)
pkgver=20260916
pkgrel=1
pkgdesc="Firmware files for Linux"
url="https://git.kernel.org/?p=linux/kernel/git/firmware/linux-firmware.git;a=summary"
license=('GPL-2.0-only' 'GPL-3.0-or-later' 'LicenseRef-linux-firmware')
arch=('any')
makedepends=('zstd' 'rdfind')
options=(!strip !debug)
source=("https://cdn.kernel.org/pub/linux/kernel/firmware/${pkgbase}-${pkgver}.tar.xz")
sha256sums=('SKIP')

build() {
  cd ${pkgbase}-${pkgver}
  # install everything once, zstd-compressed and de-duplicated, into a staging tree;
  # every package below picks its own part of it
  make DESTDIR="$srcdir/stage" FIRMWAREDIR=/usr/lib/firmware install-zst
}

# move paths/globs (relative to /usr/lib/firmware) from the staging tree into $pkgdir
_pick_fw() {
  local f g
  cd "$srcdir/stage/usr/lib/firmware"
  install -d "$pkgdir/usr/lib/firmware"
  for f in "$@"; do
    for g in $f; do
      [[ -e $g || -L $g ]] || continue
      install -d "$pkgdir/usr/lib/firmware/$(dirname "$g")"
      mv "$g" "$pkgdir/usr/lib/firmware/$(dirname "$g")/"
    done
  done
}

package_linux-firmware-whence() {
  pkgdesc="Firmware files for Linux - Contains the WHENCE license file which documents the vendor license details"
  license=('LicenseRef-linux-firmware')
  install -Dm644 "$srcdir/${pkgbase}-${pkgver}/WHENCE" "$pkgdir/usr/share/licenses/$pkgname/WHENCE"
  for f in "$srcdir/${pkgbase}-${pkgver}"/LICEN[CS]E.*; do
    install -Dm644 "$f" "$pkgdir/usr/share/licenses/$pkgname/$(basename "$f")"
  done
}

package_linux-firmware-amdgpu() {
  pkgdesc="Firmware files for Linux - Firmware for AMD GPUs"
  depends=(linux-firmware-whence)
  _pick_fw amdgpu amdnpu amdtee amdxdna
}

package_linux-firmware-atheros() {
  pkgdesc="Firmware files for Linux - Firmware for Qualcomm Atheros WiFi/Bluetooth adapters"
  depends=(linux-firmware-whence)
  _pick_fw 'ath*' qca htc_7010.fw htc_9271.fw
}

package_linux-firmware-broadcom() {
  pkgdesc="Firmware files for Linux - Firmware for Broadcom NICs/WiFi/Bluetooth"
  depends=(linux-firmware-whence)
  _pick_fw brcm bnx2 bnx2x 'bcm*' cypress
}

package_linux-firmware-cirrus() {
  pkgdesc="Firmware files for Linux - Firmware for Cirrus Logic audio codecs"
  depends=(linux-firmware-whence)
  _pick_fw cirrus cs35l56 cs42l43
}

