# Maintainer: Ovi Chis <ovi@ovios.org>
# Based on the Arch Linux package layout

pkgname=perl-http-cookiejar
pkgver=0.014
pkgrel=5
pkgdesc='A minimalist HTTP user agent cookie jar'
arch=(any)
url='https://metacpan.org/release/HTTP-CookieJar'
license=('Apache-2.0')
depends=(perl perl-http-date perl-try-tiny perl-uri)
options=(!emptydirs)
source=("https://cpan.metacpan.org/authors/id/D/DA/DAGOLDEN/HTTP-CookieJar-$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
  cd HTTP-CookieJar-$pkgver
  perl Makefile.PL INSTALLDIRS=vendor NO_PACKLIST=1 NO_PERLLOCAL=1
  make
}

check() {
  cd HTTP-CookieJar-$pkgver
  make test
}

package() {
  cd HTTP-CookieJar-$pkgver
  make DESTDIR="$pkgdir" install
}
