# Maintainer: Ovi Chis <ovi@ovios.org>
# Based on the Arch Linux package layout

pkgname=python-rpds-py
_name=rpds_py
pkgver=2026.9.1
pkgrel=1
pkgdesc='Python bindings to the Rust rpds crate (persistent data structures)'
arch=(x86_64)
url="https://pypi.org/project/${_name//_/-}/"
license=(MIT)
depends=(python glibc gcc-libs)
makedepends=(python-maturin python-build python-installer rust)
source=("https://files.pythonhosted.org/packages/source/${_name::1}/$_name/$_name-$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
  cd $_name-$pkgver
  python -m build --wheel --no-isolation
}

package() {
  cd $_name-$pkgver
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 -t "$pkgdir/usr/share/licenses/$pkgname" COPYING* LICENSE* 2>/dev/null || true
}
